{
  "$schema": "node_modules/wrangler/config-schema.json",
  // vorq.agency is not attached here. A custom domain changes DNS.
  // Add it from the Cloudflare dashboard at cutover. Steps are in the PR.
  "name": "vorq-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
