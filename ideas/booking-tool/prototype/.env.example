# Booking emails (app/api/book). Without these, bookings fall back to a pre-filled email.
# Create a key at https://resend.com and verify the sending domain there.
RESEND_API_KEY=
# The sender, on a domain verified in Resend.
BOOKING_FROM="VORQ <bookings@vorq.agency>"
# Where new bookings go. Defaults to hello@vorq.agency.
BOOKING_TO=
